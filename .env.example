# CardioGuard AI - Environment Configuration

# Security & JWT Tokens
SECRET_KEY=cardioguard-super-secret-production-jwt-key-2026-secure-random-seed
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite default (runs natively with zero setup):
DATABASE_URL=sqlite:///./cardioguard.db

# Docker / Production PostgreSQL option:
# DATABASE_URL=postgresql://cardioguard:cardioguard_secure_pwd_2026@localhost:5432/cardioguard_db
POSTGRES_USER=cardioguard
POSTGRES_PASSWORD=cardioguard_secure_pwd_2026
POSTGRES_DB=cardioguard_db

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

